# ─── Repo Steward backend configuration ─────────────────────────────────────
# Copy to .env and fill in values. The backend loads this file at startup.
# Keys are only ever read by the Node backend; they are never sent to the
# browser. GET /api/ai/status reports *whether* a provider is configured,
# never the key itself.

# Port for the Express backend (the Vite dev server proxies /api here).
PORT=8787

# ─── Live AI mode (optional) ─────────────────────────────────────────────────
# Live AI mode is entirely optional. Scripted Demo mode and Deterministic
# Mock mode work with no keys at all.
#
# When both providers are fully configured (key + model), Anthropic is
# preferred.

# Anthropic — https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
# A current model id, e.g. claude-sonnet-4-5 (see https://docs.claude.com/en/docs/about-claude/models)
# ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI — https://platform.openai.com/
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Request timeout for provider calls, in milliseconds.
AI_TIMEOUT_MS=45000

# ─── Real GitHub adapter (optional, CLI only) ───────────────────────────────
# The GitHub runner (npm run steward) is dry-run by default. It only writes
# comments/labels when BOTH of these are true:
#   1. REPO_STEWARD_WRITE=true
#   2. a GITHUB_TOKEN with the necessary scopes is present
# It never merges, never pushes, and never modifies source code.
# REPO_STEWARD_WRITE=false
# GITHUB_TOKEN=ghp_... (inside GitHub Actions, use the built-in token)
